# =============================================================
# pick-a-meme 환경변수 예시 파일
# 이 파일은 git에 커밋됩니다.
# 실제 값은 .env.local 에 작성하고 절대 커밋하지 마세요.
# =============================================================

# -------------------------------------------------------------
# Database — NEON (PostgreSQL 17)
# 콘솔: https://console.neon.tech → Connection string 복사
# -------------------------------------------------------------
DB_URL=jdbc:postgresql://<host>.neon.tech/<dbname>?sslmode=require
DB_USERNAME=<neon-username>
DB_PASSWORD=<neon-password>

# -------------------------------------------------------------
# Redis — Upstash
# 콘솔: https://console.upstash.com → REST URL / Token
# TLS 필수 → rediss:// (s 붙음)
# -------------------------------------------------------------
REDIS_URL=rediss://<host>.upstash.io:6379
REDIS_PASSWORD=<upstash-token>

# -------------------------------------------------------------
# OAuth2 — Kakao
# 콘솔: https://developers.kakao.com → 내 애플리케이션
# client-id   : REST API 키
# client-secret: 보안 → Client Secret 코드
# -------------------------------------------------------------
KAKAO_CLIENT_ID=<rest-api-key>
KAKAO_CLIENT_SECRET=<client-secret>

# -------------------------------------------------------------
# OAuth2 — Google
# 콘솔: https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>

# -------------------------------------------------------------
# JWT
# 최소 32자 이상의 랜덤 문자열 권장
# 생성 예시: openssl rand -base64 32
# -------------------------------------------------------------
JWT_SECRET=<min-32-char-random-string>

# -------------------------------------------------------------
# Cloudflare R2 (S3 Compatible Storage)
# 콘솔: https://dash.cloudflare.com → R2 → 버킷 → API 토큰 관리
# R2_ENDPOINT: https://<account-id>.r2.cloudflarestorage.com
# -------------------------------------------------------------
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=pick-a-meme
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>

# -------------------------------------------------------------
# OAuth2 Redirect URI
# 로그인 성공 후 프론트엔드로 리다이렉트되는 주소
# 로컬: http://localhost:3000/oauth2/callback
# 프로덕션: https://your-domain.com/oauth2/callback
# -------------------------------------------------------------
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/callback
