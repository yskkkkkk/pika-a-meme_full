# =============================================================
# 로컬 개발용 환경변수 예시
# 이 파일을 복사해서 .env.local 로 저장 후 값을 채우세요.
# .env.local 은 .gitignore 에 등록되어 있어 커밋되지 않습니다.
# =============================================================

# ── JWT ──────────────────────────────────────────────────────
# 32자 이상 임의 문자열이면 됩니다 (로컬 전용)
JWT_SECRET=local-dev-secret-please-change-in-production-32chars

# ── PostgreSQL ───────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/pika_meme
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── Cloudflare R2 ────────────────────────────────────────────
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
R2_BUCKET_NAME=pika-meme

# ── OAuth2 ───────────────────────────────────────────────────
KAKAO_CLIENT_ID=<KAKAO_REST_API_KEY>
KAKAO_CLIENT_SECRET=<KAKAO_CLIENT_SECRET>
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>

# 로그인 성공 후 프론트엔드 리다이렉트 URL
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/callback
